{
    "name": "hryvinskyi/magento2-deferjs",
    "description": "Moves page JavaScript to the end of the body on Magento 2 storefront pages",
    "require": {
        "php": "^8.1",
        "magento/framework": "*",
        "magento/module-config": "*",
        "magento/module-store": "*",
        "magento/module-theme": "*",
        "hryvinskyi/magento2-base": "~2.1.0",
        "tedivm/jshrink": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\DeferJs\\": ""
        }
    }
}
